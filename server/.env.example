# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/honeychain?schema=public

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-64-byte-hex-secret

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
WEB_ORIGIN=http://localhost:5173

# ─── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────────
# Get your site key & secret key from: https://dash.cloudflare.com/turnstile
# IMPORTANT: CAPTCHA_SECRET_KEY must ONLY be set on the backend. Never expose it to frontend.
# Frontend uses VITE_CAPTCHA_SITE_KEY (public). Backend uses CAPTCHA_SECRET_KEY (private).
CAPTCHA_SECRET_KEY=

# ─── Node Environment ────────────────────────────────────────────────────────
# Set to 'production' in deployment environments
NODE_ENV=development
