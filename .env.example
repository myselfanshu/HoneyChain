# Optional. Leave unset for the development proxy configured in vite.config.ts.
# For a deployed API, use its versioned API URL, for example https://api.example.com/v1
VITE_API_BASE_URL=

# Cloudflare Turnstile site key. This is public and belongs in the frontend.
# The matching private CAPTCHA_SECRET_KEY belongs only in server/.env.
VITE_CAPTCHA_SITE_KEY=
